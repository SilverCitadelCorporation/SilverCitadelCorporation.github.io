<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Study Hall - Electoral College</title>
    <style>
        body { font-family: -apple-system, sans-serif; background: #000; color: #fff; text-align: center; margin: 0; padding: 20px; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; max-width: 500px; margin: 0 auto; }
        
        /* Tap to enlarge style */
        .card { width: 100%; border-radius: 8px; cursor: pointer; border: 1px solid #333; }
        
        /* The Popup */
        .overlay {
            display: none; position: fixed; top: 0; left: 0; 
            width: 100%; height: 100%; background: rgba(0,0,0,0.9);
            justify-content: center; align-items: center; z-index: 1000;
        }
        .overlay img { max-width: 95%; max-height: 95%; object-fit: contain; }
        .overlay:target { display: flex; }
        .close { position: absolute; top: 20px; right: 20px; font-size: 30px; color: white; text-decoration: none; }
    </style>
</head>
<body>

    <h2>Electoral College Gallery</h2>
    <p style="color: #888;">Tap any image to see it full screen</p>

    <div class="grid">
        <a href="#img1"><img src="1000002941.png" class="card"></a>
        <a href="#img2"><img src="1000002942.png" class="card"></a>
        <a href="#img3"><img src="1000002943.png" class="card"></a>
        <a href="#img4"><img src="1000002944.png" class="card"></a>
    </div>

    <div id="img1" class="overlay"><a href="#" class="close">&times;</a><img src="1000002941.png"></div>
    <div id="img2" class="overlay"><a href="#" class="close">&times;</a><img src="1000002942.png"></div>
    <div id="img3" class="overlay"><a href="#" class="close">&times;</a><img src="1000002943.png"></div>
    <div id="img4" class="overlay"><a href="#" class="close">&times;</a><img src="1000002944.png"></div>

</body>
</html>
